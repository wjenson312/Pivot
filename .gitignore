# Python (build/dist/lib/etc anchored to repo root — unanchored "lib/" was
# previously matching frontend/lib and silently hiding real app source from
# git; __pycache__ stays recursive since it legitimately nests, e.g.
# backend/__pycache__)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
.venv/
venv/
ENV/
env/

# IDEs
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/

# Project specific
*.mp4
*.avi
*.mov
your_video.mp4

# Raw CSVs pulled from the device's microSD card over BLE sync (see
# frontend/lib/ble-sync.ts + frontend/app/api/runs/import) — runtime data,
# not curated source like data/cycle-1.
/data/uploaded/
